{
  "name": "discord-patch-bot",
  "version": "1.0.0",
  "description": "Bot Discord pentru update-uri automate la jocuri",
  "main": "dist/app/main.js",
  "scripts": {
    "build:rust": "cd native && napi build --platform --release --js index.js --dts index.d.ts",
    "build:ts": "node node_modules/@typescript/native/bin/tsc",
    "build": "npm run build:rust && npm run build:ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "rebuild": "npm run clean && npm run build",
    "start": "node dist/app/main.js",
    "start:local": "node --env-file=.env dist/app/main.js",
    "start:build": "npm run build && node dist/app/main.js",
    "start:worker": "node dist/app/worker.js",
    "start:worker:local": "node --env-file=.env dist/app/worker.js",
    "dev": "npm run build && npm run start:local",
    "check:config": "npm run build:ts && node dist/scripts/check-config.js",
    "check:env": "npm run build:ts && node dist/scripts/check-env.js",
    "check:redis": "npm run build:ts && node dist/scripts/check-redis.js",
    "check:dependencies": "npm run build:ts && node dist/scripts/check-dependencies.js",
    "check:layers": "npm run build:ts && node dist/scripts/check-layer-imports.js",
    "check:syntax": "npm run build:ts && node dist/scripts/check-syntax.js",
    "check:comments": "npm run build:ts && node dist/scripts/check-no-comments.js",
    "check:weakening": "npm run build:ts && node dist/scripts/check-no-weakening-types.js",
    "check:rules-sync": "npm run build:ts && node dist/scripts/check-rules-sync.js",
    "check:db-indexes": "npm run build:ts && node dist/scripts/check-db-indexes.js",
    "check:docs-commands": "npm run build:ts && node dist/scripts/generate-command-reference.js --check",
    "check:quick": "npm run build:ts && node dist/scripts/check-syntax.js && node dist/scripts/check-config.js",
    "docs:commands": "npm run build:ts && node dist/scripts/generate-command-reference.js",
    "db:export:guilds": "npm run build:ts && node dist/scripts/export-guild-configs.js",
    "benchmark": "npm run build:ts && node dist/scripts/notificationBenchmark.js",
    "benchmark:outbox": "npm run build:ts && node dist/scripts/outboxLoadBenchmark.js",
    "benchmark:cpu": "npm run build && node dist/scripts/cpuBenchmark.js",
    "benchmark:inspection": "npm run build && node dist/scripts/inspectionBenchmark.js",
    "benchmark:guard": "npm run build && node dist/scripts/benchmarkGuard.js",
    "smoke:staging": "npm run build:ts && node dist/scripts/stagingSmoke.js",
    "smoke:staging:discord": "npm run build:ts && node dist/scripts/stagingDiscordSmoke.js",
    "canary:sources": "npm run build:ts && node dist/scripts/canarySources.js",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "npm run build:ts && node dist/scripts/check-syntax.js && node dist/scripts/check-no-comments.js && node dist/scripts/check-no-nul-bytes.js && node dist/scripts/check-no-weakening-types.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "test:e2e": "npm run build && npm run test:e2e:prebuilt",
    "test:e2e:prebuilt": "node --test \"dist/test/**/*.e2e.test.js\" dist/test/outbox/outboxE2E.functional.test.js",
    "test:regression": "npm run build && node --test dist/test/commands/commands-regression.test.js dist/test/commands/configValidator.test.js",
    "test:notifications": "npm run build && node --test \"dist/test/**/*notification*.test.js\" \"dist/test/**/*Notification*.test.js\"",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "audit:strict": "npm audit --omit=dev",
    "precommit": "npm run check:full && npm run audit",
    "check": "npm run build:ts && npm run build:rust && npm run check:prebuilt",
    "check:prebuilt": "node dist/scripts/run-gates.js && node --test --test-reporter=spec \"dist/test/**/*.test.js\"",
    "check:ts-prebuilt": "npm run build:ts && npm run check:prebuilt",
    "check:native": "cargo clippy --release --manifest-path native/Cargo.toml --workspace --all-targets -- -D warnings && cargo test --release --manifest-path native/Cargo.toml -p discord_patch_bot_logic --quiet",
    "profile:tests": "npm run build:ts && node dist/scripts/profile-tests.js",
    "check:full": "npm run check && npm run check:native && npm run test:e2e:prebuilt",
    "start:web": "node dist/app/web.js",
    "start:web:local": "node --env-file=.env dist/app/web.js",
    "check:env:local": "npm run build:ts && node --env-file=.env dist/scripts/check-env.js",
    "check:redis:local": "npm run build:ts && node --env-file=.env dist/scripts/check-redis.js",
    "doctor:local": "npm run build:ts && node --env-file=.env dist/scripts/check-env.js && node --env-file=.env dist/scripts/check-config.js && node --env-file=.env dist/scripts/check-mongo.js && node --env-file=.env dist/scripts/check-redis.js",
    "db:export:guilds:raw": "npm run build:ts && node dist/scripts/export-guild-configs.js --raw",
    "check:mongo:local": "npm run build:ts && node --env-file=.env dist/scripts/check-mongo.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "axios": "1.18.1",
    "cheerio": "1.2.0",
    "discord.js": "14.27.0",
    "mongoose": "9.7.4",
    "redis": "6.1.0",
    "rss-parser": "3.13.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.3",
    "@types/node": "26.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "form-data": ">=4.0.6",
    "ws": ">=8.21.0",
    "discord.js": {
      "undici": ">=6.27.0 <7"
    },
    "cheerio": {
      "undici": ">=7.28.0 <8"
    }
  },
  "type": "module"
}
