# Copy this file to src/.env for local development.
# Do not commit real tokens, Mongo credentials, webhooks or proxy URLs.

# Runtime mode and local HTTP server.
NODE_ENV=development
PORT=3000

# Required: MongoDB connection used by the bot.
# Docker Compose overrides this to mongodb://mongo:27017/discord-patch-bot.
MONGO_URI=mongodb://localhost:27017/discord-patch-bot

# Required: Discord application credentials from the Discord Developer Portal.
DISCORD_TOKEN=replace_with_discord_bot_token
DISCORD_CLIENT_ID=replace_with_discord_application_client_id

# Metrics endpoint.
# Local development can use METRICS_PUBLIC=true.
# Production should use METRICS_PUBLIC=false and a strong METRICS_TOKEN.
METRICS_PUBLIC=true
METRICS_TOKEN=

# Reverse proxy support.
# Set TRUST_PROXY=true only behind a trusted proxy that controls X-Forwarded-For.
TRUST_PROXY=false
# Number of trusted proxies that append to X-Forwarded-For between the bot and the
# client (only used when TRUST_PROXY=true; default 1 = a single reverse proxy/LB).
# The client IP for rate limiting is taken as segments[length - TRUSTED_PROXY_COUNT]
# (skips your trusted hops from the right); set it higher when you have a chain like
# CDN -> LB -> bot so clients are not all grouped under the nearest proxy IP.
# TRUSTED_PROXY_COUNT=1

# Optional admin alert webhook for operational warnings.
# Keep empty locally unless you want Discord webhook alerts.
ADMIN_WEBHOOK_URL=

# Optional comma-separated proxy templates for external scraping fallbacks.
# Each template must contain {url}; never commit private proxy credentials.
# Example: https://proxy.example/fetch?target={url}
PROXY_URLS=

# Built-in third-party proxies (allorigins/codetabs) are enabled only in
# NODE_ENV=development. In other non-production environments (e.g. staging) set
# ALLOW_DEFAULT_PROXIES=true to enable them; otherwise they stay off so target
# URLs are not leaked to third parties. Never enabled in production.
# ALLOW_DEFAULT_PROXIES=false

# In NODE_ENV=production the Rust native addon is required: if it cannot be loaded
# the bot fails fast at boot (the TypeScript fallback can produce divergent hashes
# -> notification spam). Set to true only to explicitly allow the TS fallback in prod.
# ALLOW_NATIVE_FALLBACK=false

# DB migrations run at boot. By default a failed migration is fatal (fail-fast):
# the bot aborts startup so it never runs with an inconsistent schema (e.g. missing
# the unique dedupe index -> duplicate notifications). The orchestrator restart then
# retries the migration. Set to true to start anyway despite a failed migration
# (emergency escape hatch; at your own risk).
# MIGRATIONS_CONTINUE_ON_ERROR=false

# Logging verbosity. Common values: ERROR, WARN, INFO, DEBUG.
LOG_LEVEL=INFO

# Fetching and parsing limits.
# FETCH_CONCURRENCY is the fallback per-source concurrency for update fetching.
# Each source group runs in its own pool so a slow source does not block the cycle.
# FETCH_CONCURRENCY=10
# FETCH_CONCURRENCY_STEAM=4
# FETCH_CONCURRENCY_EPIC=2
# FETCH_CONCURRENCY_LISTING=8
# FETCH_CONCURRENCY_DRIVER=2
# MAX_HTML_BYTES=500000
# MAX_JSON_BYTES=5000000
# INFLIGHT_PROMISE_TIMEOUT_MS=120000

# Deals/source limits.
# MAX_DEALS=50
# STEAM_SPECIALS_LIMIT=30
# EPIC_SPECIALS_LIMIT=20
# STEAM_REVIEW_BATCH_SIZE=5
# STEAM_REVIEW_BATCH_DELAY_MS=500
# DEALS_CURRENCY_CACHE_MAX_SIZE=8
# ENRICHED_DEAL_CACHE_TTL_MS=600000
# ENRICHED_DEAL_CACHE_MAX_SIZE=500

# Discord send and cron throughput.
# DISCORD_SEND_DELAY_MS=800
# MAX_UPDATES_PER_CYCLE=5
# MAX_DEALS_PER_CYCLE=8
# GUILD_PROCESS_CONCURRENCY=3
# USER_COMMAND_COOLDOWN_MS=10000

# Global Discord send rate limiter (token bucket) applied to all outbound
# notifications. Caps bursts on top of the per-send delay above. acquire() never
# blocks longer than DISCORD_SEND_RATE_MAX_WAIT_MS, so a misconfig cannot deadlock sends.
# DISCORD_SEND_RATE_CAPACITY=5
# DISCORD_SEND_RATE_PER_SEC=5
# DISCORD_SEND_RATE_MAX_WAIT_MS=5000

# Optional notification outbox (for running on many servers). When true, the cron
# enqueues messages into the notificationOutbox collection instead of sending
# inline, and a dedicated background worker drains them on its own interval with
# rate limit + retry/backoff + dead-letter. Decouples sending from detection and
# survives Discord downtime. Default off; recommended for high notification volume.
# Outbox health is exposed at /metrics: bot_outbox_sent, bot_outbox_retried,
# bot_outbox_dead_lettered, bot_outbox_drains, bot_outbox_queue_depth,
# bot_outbox_delivery_ms_total, bot_outbox_oldest_job_age_seconds,
# bot_outbox_lock_acquire_failures, bot_outbox_mark_sent_failures,
# bot_outbox_recovery_verify_enabled_guilds.
# The notificationOutbox queue also has a sparse unique index on dedupeKey, so two
# pending jobs with identical content cannot coexist. When a drain reports recovery
# read failures or mark-sent failures, the worker also sends a cooldowned admin alert.
# To enable in production, set both of the first two together:
# NOTIFICATION_OUTBOX_ENABLED=true
# NOTIFICATION_OUTBOX_DRAIN_INTERVAL_MS=15000
#
# NOTIFICATION_OUTBOX_ENABLED=false
# NOTIFICATION_OUTBOX_DRAIN_INTERVAL_MS: how often the outbox worker drains queued
# jobs, independent of the cron cycle (default 15000; min 2000, max 600000). A
# shorter interval keeps the backlog small under many notifications/retries.
# NOTIFICATION_OUTBOX_DRAIN_INTERVAL_MS=15000
# NOTIFICATION_OUTBOX_DRAIN_LIMIT: max jobs drained per cycle (default 50; min 1,
# max 1000). The drain lock TTL auto-scales with this value and the Discord send
# budget, so raising it keeps the lock valid for the whole drain.
# NOTIFICATION_OUTBOX_DRAIN_LIMIT=50
# NOTIFICATION_OUTBOX_LOCK_TTL_MS: override for the outbox drain lock TTL (default
# auto-sized from drain limit + Discord send budget; min 120000, max 3600000).
# Raise it only if a single drain can legitimately exceed the auto-sized default.
# NOTIFICATION_OUTBOX_LOCK_TTL_MS=
# NOTIFICATION_OUTBOX_SENT_TTL_HOURS: how long the delivered-dedupe history
# (notificationOutboxSent) is kept, used to skip re-sending a job recovered after
# a crash (default 24; min 1, max 168). Longer covers recovery after long downtime.
# NOTIFICATION_OUTBOX_SENT_TTL_HOURS=24
# NOTIFICATION_OUTBOX_RECOVERY_VERIFY (default false): extra safety against the
# rare send->markSent crash window. When true, each outbox embed carries a small
# dedupe marker in its footer, and a re-claimed job (deliveries>1) first checks the
# channel's recent messages for that marker before re-sending. Costs a visible
# footer + a Discord message fetch per recovery; leave off unless you need it.
# Can be overridden per-guild via the guild's `outboxRecoveryVerify` setting.
# Metrics at /metrics: bot_outbox_recovery_duplicates_prevented,
# bot_outbox_recovery_history_fetches, bot_outbox_recovery_verify_failures,
# bot_outbox_recovery_marker_missing.
# NOTIFICATION_OUTBOX_RECOVERY_VERIFY=false
# NOTIFICATION_OUTBOX_RECOVERY_HISTORY_LIMIT: how many recent channel messages the
# recovery check scans for the dedupe marker (default 25; min 5, max 100). Raise
# on busy channels where a notification can be pushed past 25 messages quickly.
# NOTIFICATION_OUTBOX_RECOVERY_HISTORY_LIMIT=25
# NOTIFICATION_OUTBOX_RECOVERY_STRICT (default false): strict recovery-verify mode.
# When the channel-history fetch fails (cannot read messages), instead of sending
# anyway (fail-open) the worker does NOT send, reschedules the job with backoff and
# counts recoveryFailures + sends an admin alert (fail-closed). Use on servers where
# duplicates are very costly. Requires NOTIFICATION_OUTBOX_RECOVERY_VERIFY=true.
# NOTIFICATION_OUTBOX_RECOVERY_STRICT=false

# Cron pacing.
# CRON_INTERVAL_MS only accepts 600000/900000/1800000/3600000 (10/15/30/60 min).
# CRON_JITTER_MS adds a random +/- offset to each next-cycle delay so multiple
# instances do not wake at the same instant and hammer the Mongo lock (0 disables).
# CRON_CYCLE_BUDGET_MS: if a cycle runs longer than this, the next cycle skips
# discounts once to recover (0 disables; defaults to one CRON_INTERVAL_MS).
# CRON_INTERVAL_MS=1800000
# CRON_JITTER_MS=20000
# CRON_CYCLE_BUDGET_MS=1800000

# Circuit breaker and schema-drift protection.
# CIRCUIT_BREAKER_FAIL_THRESHOLD=5
# CIRCUIT_BREAKER_COOLDOWN_MS=2700000
# CIRCUIT_BREAKER_JITTER_MS=900000
# SCHEMA_DRIFT_THRESHOLD=3
# GLOBAL_HEALTH_WINDOW=5
# GLOBAL_HEALTH_MIN_RATIO=30

# History and pending queue sizes.
# SEEN_PER_GAME_LIMIT=20
# DEALS_HISTORY_LIMIT=300
# PENDING_UPDATES_PER_GAME_LIMIT=5
# PENDING_DISCOUNTS_LIMIT=200
# PENDING_UPDATE_MAX_AGE_MS=86400000
# PENDING_DISCOUNT_GRACE_CYCLES=3
# PENDING_UPDATE_MAX_ATTEMPTS=5
# PENDING_DISCOUNT_MAX_ATTEMPTS=10

# Mongo and local state caches.
# MONGO_MAX_POOL_SIZE=15
# MONGO_RETRY_ATTEMPTS=2
# GUILD_CACHE_TTL_MS=60000
# GUILD_CACHE_MAX_SIZE=1000
# SHUTDOWN_DRAIN_MS=5000
# HOUSEKEEPING_INTERVAL_MS=120000
# ADMIN_ALERT_COOLDOWN_MS=1800000

# HTTP health/metrics rate limit.
# HTTP_RATE_LIMIT_REQ=60
# HTTP_RATE_LIMIT_WINDOW_MS=60000

# Discord UI/cache output sizing.
# CACHE_TTL_MS=180000
# SINGLE_CACHE_MAX_SIZE=100
# DLC_CACHE_MAX_SIZE=100
# ITEMS_PER_PAGE=5
# DLC_ITEMS_PER_PAGE=10
# COMMAND_OUTPUT_MAX_CHARS=1900
# MAX_FUZZY_SEARCH_INPUT=100

# Recommended tuning presets. The real bottleneck is external sources + Discord
# rate limits + Mongo writes, not CPU, so do not push FETCH_CONCURRENCY to 30-50.
#
# Small / medium bot:
# FETCH_CONCURRENCY=8
# GUILD_PROCESS_CONCURRENCY=3
# DISCORD_SEND_DELAY_MS=800
# MONGO_MAX_POOL_SIZE=15
# MAX_UPDATES_PER_CYCLE=5
# MAX_DEALS_PER_CYCLE=8
#
# Many servers:
# FETCH_CONCURRENCY=12
# GUILD_PROCESS_CONCURRENCY=5
# DISCORD_SEND_DELAY_MS=500
# MONGO_MAX_POOL_SIZE=30
# MAX_UPDATES_PER_CYCLE=5
# MAX_DEALS_PER_CYCLE=8
