NODE_ENV=production
PORT=3000

MONGO_URI=mongodb+srv://user:password@cluster.example/database
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_id
CONFIG_PATH=./config.json

# In production, either set METRICS_TOKEN or explicitly opt into public metrics.
METRICS_TOKEN=change_me_to_a_long_random_value
# METRICS_PUBLIC=false

# Optional admin alert webhook.
# ADMIN_WEBHOOK_URL=https://discord.com/api/webhooks/...

LOG_LEVEL=INFO
# LOG_FORMAT=json

# Optional trusted proxy templates, comma-separated, each containing {url}.
# PROXY_URLS=https://your-proxy.example/fetch?url={url}

# =============================================================
# V9 — Variabile noi (toate au default-uri sigure; setați doar
# pe cele relevante deployment-ului vostru)
# =============================================================

# --- MongoDB pool ---
# Limită maximă conexiuni concurente către Mongo. Cresc dacă rulați
# multe guild-uri active simultan (peste 50-100 guild-uri active).
# MONGO_MAX_POOL_SIZE=15

# --- Shutdown ---
# Drain delay între eliberarea lock-urilor și destroy client.
# Permite comenzilor în zbor să răspundă înainte de exit. V9 default 5000 (era 2000).
# SHUTDOWN_DRAIN_MS=5000

# --- HTTP rate limiting (per IP, pentru /health și /metrics) ---
# Token bucket per IP, refill liniar pe fereastră.
# HTTP_RATE_LIMIT_REQ=60
# HTTP_RATE_LIMIT_WINDOW_MS=60000

# --- Cache tuning (mutate din magic numbers în env) ---
# TTL pentru cache-urile per-game (single update) și DLC.
# CACHE_TTL_MS=180000
# SINGLE_CACHE_MAX_SIZE=100
# DLC_CACHE_MAX_SIZE=100

# --- Pagination / output ---
# ITEMS_PER_PAGE=5
# DLC_ITEMS_PER_PAGE=10
# COMMAND_OUTPUT_MAX_CHARS=1900
