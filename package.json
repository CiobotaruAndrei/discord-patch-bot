{
  "name": "discord-patch-bot",
  "version": "1.0.0",
  "description": "Bot Discord pentru update-uri automate la jocuri",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "check:config": "node scripts/check-config.js",
    "check:syntax": "node scripts/check-syntax.js",
    "typecheck": "tsc --noEmit",
    "lint": "npm run check:syntax",
    "test": "node --test",
    "check": "npm run check:config && npm run check:syntax && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "1.7.7",
    "cheerio": "1.0.0-rc.12",
    "discord.js": "14.26.0",
    "mongoose": "8.2.1",
    "rss-parser": "3.13.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@types/node": "20.19.39",
    "typescript": "5.9.3"
  }
}
